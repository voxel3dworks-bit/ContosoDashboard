@page "/documents"
@using ContosoDashboard.Services
@using ContosoDashboard.Shared
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <h1>My Documents</h1>
            <button class="btn btn-primary" @onclick="OpenUploadModal">
                <span class="bi bi-upload" aria-hidden="true"></span> Upload Document
            </button>
        </div>
    </div>

    <div class="row mb-3 g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small text-muted">Search</label>
            <div class="input-group">
                <input class="form-control" placeholder="Title, description, tags, uploader, project..."
                       @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                <button class="btn btn-outline-secondary" @onclick="LoadDocumentsAsync">
                    <span class="bi bi-search" aria-hidden="true"></span>
                </button>
                @if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                        <span class="bi bi-x" aria-hidden="true"></span>
                    </button>
                }
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Category</label>
            <select class="form-select" @bind="_query.CategoryFilter" @bind:after="LoadDocumentsAsync">
                <option value="">All categories</option>
                @foreach (var category in Models.DocumentCategories.All)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Project</label>
            <select class="form-select" @bind="_projectFilterValue" @bind:after="LoadDocumentsAsync">
                <option value="">All projects</option>
                @foreach (var project in _availableProjects)
                {
                    <option value="@project.ProjectId">@project.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">From</label>
            <input type="date" class="form-control" @bind="_query.UploadedFrom" @bind:format="yyyy-MM-dd" @bind:after="LoadDocumentsAsync" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">To</label>
            <input type="date" class="form-control" @bind="_query.UploadedTo" @bind:format="yyyy-MM-dd" @bind:after="LoadDocumentsAsync" />
        </div>
    </div>

    @if (_isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else if (_documents.Count == 0)
    {
        <div class="alert alert-info">
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <text>No documents match your search.</text>
            }
            else
            {
                <text>No documents found. Click "Upload Document" to get started.</text>
            }
        </div>
    }
    else
    {
        <p class="text-muted small">Showing @_documents.Count of @_totalCount document(s)</p>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th role="button" @onclick='() => SortByAsync(DocumentSortField.Title)'>
                            Title @SortIndicator(DocumentSortField.Title)
                        </th>
                        <th role="button" @onclick='() => SortByAsync(DocumentSortField.Category)'>
                            Category @SortIndicator(DocumentSortField.Category)
                        </th>
                        <th role="button" @onclick='() => SortByAsync(DocumentSortField.UploadDate)'>
                            Upload Date @SortIndicator(DocumentSortField.UploadDate)
                        </th>
                        <th role="button" @onclick='() => SortByAsync(DocumentSortField.FileSizeBytes)'>
                            File Size @SortIndicator(DocumentSortField.FileSizeBytes)
                        </th>
                        <th>Project</th>
                        @if (!string.IsNullOrWhiteSpace(_searchTerm))
                        {
                            <th>Uploaded By</th>
                        }
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var document in _documents)
                    {
                        <tr>
                            <td>@document.Title</td>
                            <td><span class="badge bg-secondary">@document.Category</span></td>
                            <td>@document.UploadDate.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</td>
                            <td>@FormatFileSize(document.FileSizeBytes)</td>
                            <td>@(document.ProjectName ?? "Personal")</td>
                            @if (!string.IsNullOrWhiteSpace(_searchTerm))
                            {
                                <td>@document.UploaderName</td>
                            }
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="/documents/@document.DocumentId/download" target="_blank">
                                    <span class="bi bi-download" aria-hidden="true"></span> Download
                                </a>
                                @if (IsPreviewable(document.FileType))
                                {
                                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => ShowPreview(document)">
                                        <span class="bi bi-eye" aria-hidden="true"></span> Preview
                                    </button>
                                }
                                @if (document.UploadedByUserId == _currentUserId)
                                {
                                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => OpenEditModal(document)">
                                        <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => OpenShareModal(document)">
                                        <span class="bi bi-share" aria-hidden="true"></span> Share
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => ConfirmDelete(document)">
                                        <span class="bi bi-trash" aria-hidden="true"></span> Delete
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_previewDocument != null)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_previewDocument.Title</h5>
                    <button type="button" class="btn-close" @onclick="ClosePreview" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    @if (IsImage(_previewDocument.FileType))
                    {
                        <img src="/documents/@_previewDocument.DocumentId/preview" alt="@_previewDocument.Title" class="img-fluid" />
                    }
                    else
                    {
                        <iframe src="/documents/@_previewDocument.DocumentId/preview" title="@_previewDocument.Title" style="width: 100%; height: 70vh; border: none;"></iframe>
                    }
                </div>
                <div class="modal-footer">
                    <a class="btn btn-primary" href="/documents/@_previewDocument.DocumentId/download" target="_blank">
                        <span class="bi bi-download" aria-hidden="true"></span> Download
                    </a>
                    <button type="button" class="btn btn-secondary" @onclick="ClosePreview">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_deleteCandidate != null)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Document</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_deleteErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@_deleteErrorMessage</div>
                    }
                    <p>Are you sure you want to permanently delete <strong>@_deleteCandidate.Title</strong>?</p>
                    <p class="text-muted small">This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete" disabled="@_isDeleting">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_isDeleting">
                        @(_isDeleting ? "Deleting..." : "Delete")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_shareCandidate != null)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Share "@_shareCandidate.Title"</h5>
                    <button type="button" class="btn-close" @onclick="CancelShare" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_shareErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@_shareErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(_shareSuccessMessage))
                    {
                        <div class="alert alert-success" role="alert">@_shareSuccessMessage</div>
                    }

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="shareMode" id="shareModeUser"
                                   checked="@(!_shareByDepartment)" @onchange="() => _shareByDepartment = false" />
                            <label class="form-check-label" for="shareModeUser">Share with a specific person</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="shareMode" id="shareModeDepartment"
                                   checked="@_shareByDepartment" @onchange="() => _shareByDepartment = true" />
                            <label class="form-check-label" for="shareModeDepartment">Share with a department</label>
                        </div>
                    </div>

                    @if (!_shareByDepartment)
                    {
                        <div class="mb-3">
                            <label class="form-label">Person</label>
                            <select class="form-select" @bind="_shareTargetUserId">
                                <option value="">-- Select a person --</option>
                                @foreach (var user in _allUsers.Where(u => u.UserId != _currentUserId))
                                {
                                    <option value="@user.UserId">@user.DisplayName (@user.Department)</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Department</label>
                            <select class="form-select" @bind="_shareTargetDepartment">
                                <option value="">-- Select a department --</option>
                                @foreach (var department in _departments)
                                {
                                    <option value="@department">@department</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelShare" disabled="@_isSharing">Close</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitShareAsync" disabled="@_isSharing">
                        @(_isSharing ? "Sharing..." : "Share")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<DocumentUploadModal @ref="_uploadModal"
                      CurrentUserId="_currentUserId"
                      AvailableProjects="_availableProjects"
                      OnUploaded="HandleDocumentUploaded"
                      OnEdited="HandleDocumentEdited" />

@code {
    private int _currentUserId;
    private List<Models.Project> _availableProjects = new();
    private List<DocumentSummary> _documents = new();
    private int _totalCount;
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private DocumentQuery _query = new();
    private DocumentUploadModal? _uploadModal;
    private DocumentSummary? _previewDocument;
    private DocumentSummary? _deleteCandidate;
    private bool _isDeleting;
    private string? _deleteErrorMessage;

    private List<Models.User> _allUsers = new();
    private List<string> _departments = new();
    private DocumentSummary? _shareCandidate;
    private bool _shareByDepartment;
    private int? _shareTargetUserId;
    private string? _shareTargetDepartment;
    private bool _isSharing;
    private string? _shareErrorMessage;
    private string? _shareSuccessMessage;

    private static readonly HashSet<string> PreviewableContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "application/pdf", "image/jpeg", "image/png"
    };

    private int? _projectFilterValue
    {
        get => _query.ProjectIdFilter;
        set => _query.ProjectIdFilter = value;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
        {
            _currentUserId = userId;
            _availableProjects = await ProjectService.GetUserProjectsAsync(_currentUserId);
            _allUsers = await UserService.GetAllUsersAsync();
            _departments = _allUsers
                .Select(u => u.Department)
                .Where(d => !string.IsNullOrWhiteSpace(d))
                .Distinct()
                .OrderBy(d => d)
                .Select(d => d!)
                .ToList();
            await LoadDocumentsAsync();
        }
    }

    private async Task LoadDocumentsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var result = string.IsNullOrWhiteSpace(_searchTerm)
            ? await DocumentService.GetMyDocumentsAsync(_currentUserId, _query)
            : await DocumentService.SearchAsync(_currentUserId, _searchTerm.Trim(), _query);

        _documents = result.Items.ToList();
        _totalCount = result.TotalCount;
        _isLoading = false;
        StateHasChanged();
    }

    private async Task OnSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadDocumentsAsync();
        }
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await LoadDocumentsAsync();
    }

    private async Task SortByAsync(DocumentSortField field)
    {
        if (_query.SortBy == field)
        {
            _query.SortDescending = !_query.SortDescending;
        }
        else
        {
            _query.SortBy = field;
            _query.SortDescending = false;
        }

        await LoadDocumentsAsync();
    }

    private string SortIndicator(DocumentSortField field)
    {
        if (_query.SortBy != field)
        {
            return string.Empty;
        }

        return _query.SortDescending ? "▼" : "▲";
    }

    private void OpenUploadModal()
    {
        _uploadModal?.Show();
    }

    private void ShowPreview(DocumentSummary document)
    {
        _previewDocument = document;
    }

    private void ClosePreview()
    {
        _previewDocument = null;
    }

    private static bool IsPreviewable(string fileType) => PreviewableContentTypes.Contains(fileType);

    private static bool IsImage(string fileType) => fileType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private async Task HandleDocumentUploaded(UploadedDocumentInfo document)
    {
        await LoadDocumentsAsync();
    }

    private async Task OpenEditModal(DocumentSummary document)
    {
        var detail = await DocumentService.GetByIdAsync(_currentUserId, document.DocumentId);
        if (detail != null)
        {
            _uploadModal?.ShowForEdit(detail);
        }
    }

    private async Task HandleDocumentEdited()
    {
        await LoadDocumentsAsync();
    }

    private void ConfirmDelete(DocumentSummary document)
    {
        _deleteCandidate = document;
        _deleteErrorMessage = null;
    }

    private void CancelDelete()
    {
        _deleteCandidate = null;
        _deleteErrorMessage = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteCandidate == null)
        {
            return;
        }

        _isDeleting = true;
        StateHasChanged();

        var success = await DocumentService.DeleteAsync(_currentUserId, _deleteCandidate.DocumentId);

        _isDeleting = false;

        if (success)
        {
            _deleteCandidate = null;
            await LoadDocumentsAsync();
        }
        else
        {
            _deleteErrorMessage = "Failed to delete the document. You may not have permission.";
            StateHasChanged();
        }
    }

    private void OpenShareModal(DocumentSummary document)
    {
        _shareCandidate = document;
        _shareByDepartment = false;
        _shareTargetUserId = null;
        _shareTargetDepartment = null;
        _shareErrorMessage = null;
        _shareSuccessMessage = null;
    }

    private void CancelShare()
    {
        _shareCandidate = null;
    }

    private async Task SubmitShareAsync()
    {
        if (_shareCandidate == null)
        {
            return;
        }

        _shareErrorMessage = null;
        _shareSuccessMessage = null;

        var target = _shareByDepartment
            ? new ShareTarget { Department = _shareTargetDepartment }
            : new ShareTarget { UserId = _shareTargetUserId };

        if (!_shareByDepartment && _shareTargetUserId == null)
        {
            _shareErrorMessage = "Please select a person to share with.";
            return;
        }

        if (_shareByDepartment && string.IsNullOrWhiteSpace(_shareTargetDepartment))
        {
            _shareErrorMessage = "Please select a department to share with.";
            return;
        }

        _isSharing = true;
        StateHasChanged();

        var success = await DocumentService.ShareAsync(_currentUserId, _shareCandidate.DocumentId, target);

        _isSharing = false;

        if (success)
        {
            _shareSuccessMessage = "Document shared successfully.";
            _shareTargetUserId = null;
            _shareTargetDepartment = null;
        }
        else
        {
            _shareErrorMessage = "Failed to share the document. You may not have permission.";
        }

        StateHasChanged();
    }

    private static string FormatFileSize(long bytes)
    {
        return bytes switch
        {
            < 1024 => $"{bytes} B",
            < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
            _ => $"{bytes / (1024.0 * 1024.0):F1} MB"
        };
    }
}
